# 優先讀取上層專案 .env 的 DATABASE_URL
# 也可在此覆寫：
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
FINENGINE_PORT=8787

# —— 前端（Vite）Google 登入：與 www.quantgems.com／權證雷達同一套 OAuth ——
# Vercel 專案請設定同名環境變數（Production / Preview）
VITE_BACKEND_URL=https://taiwan-stock-returns-quantgems-vue-vercel.onrender.com
VITE_SITE_URL=https://quantgems-finengine.vercel.app

# 主站 Render OAuth redirect 白名單需放行：
#   https://quantgems-finengine.vercel.app
#   http://localhost:5178   （本地完整 OAuth 測試時）
