{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/financial-statements",
      "destination": "/financial-statements.html"
    },
    {
      "source": "/financial-screener",
      "destination": "/financial-screener.html"
    },
    {
      "source": "/((?!financial-statements(?:\\.html)?$|financial-screener(?:\\.html)?$|robots\\.txt|sitemap\\.xml|favicon\\.ico|favicon-.*\\.png|og-image\\.png|apple-touch-icon\\.png|pwa-icon.*|quantgems-finengine-icon\\.svg|quantgems-finengine-icon\\.png|analytics\\.js|manifest\\.webmanifest|sw\\.js|workbox-.*|registerSW\\.js|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
